---
import Layout from '../../layouts/Layout.astro';
import { sql, DB_CONNECTED } from '../../lib/db';
import { FALLBACK_BLOG_POSTS, type FallbackBlogPost } from '../../lib/fallback';

export async function getStaticPaths() {
  let posts: FallbackBlogPost[] = FALLBACK_BLOG_POSTS;
  if (DB_CONNECTED) {
    try {
      posts = await sql<FallbackBlogPost[]>`
        SELECT id, title, slug, excerpt, image_url, author, created_at, published, content
        FROM blog_posts
        WHERE published = true
      `;
    } catch {
      posts = FALLBACK_BLOG_POSTS;
    }
  }
  return posts.filter(post => post.published).map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: FallbackBlogPost;
}

const { post } = Astro.props;
const date = new Date(post.created_at).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Layout title={post.title} description={post.excerpt} image={post.image_url}>
  <article class="pt-36 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <a href="/blog" class="text-sm font-semibold text-gold hover:text-gold/80">← Back to blog</a>
      <header class="mt-8 mb-10">
        <p class="text-sm text-gray-400 mb-4">{date}{post.author ? ` · ${post.author}` : ''}</p>
        <h1 class="font-serif text-3xl md:text-5xl text-navy leading-tight">{post.title}</h1>
      </header>
      {post.image_url && (
        <img src={post.image_url} alt={post.title} class="w-full h-auto rounded-2xl mb-10" />
      )}
      <div class="article-content text-gray-600" set:html={post.content} />
    </div>
  </article>
</Layout>

<style>
  .article-content :global(h2) {
    margin: 2rem 0 1rem;
    color: var(--color-navy);
    font-size: 1.5rem;
    line-height: 1.4;
  }
  .article-content :global(h3) {
    margin: 1.75rem 0 0.75rem;
    color: var(--color-navy);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .article-content :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
</style>
